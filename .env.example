# Claude API (krävs för chatten). Hämtas server-side, exponeras aldrig i klienten.
ANTHROPIC_API_KEY=
# Valfritt: byt modell. Standard är claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase (valfritt). Utan dessa fungerar appen men sparar inga scenarier eller chatthistorik.
# Service role-nyckeln används endast i API-routes på servern.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
